# Flask Application Configuration
# Copy this file to .env and fill in your actual values

# Flask Secret Key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your-secret-key-here-generate-a-random-string

# Flask Debug Mode (True/False)
FLASK_DEBUG=False

# Enable Application Logging (True/False)
LOGGING_ENABLED=True

# Server Configuration (for local development)
RUNNING_HOST=0.0.0.0
RUNNING_PORT=5001

# SSL Configuration (optional - leave empty if not using HTTPS locally)
SSL_CERT_PATH=
SSL_KEY_PATH=

# Database Configuration (MySQL/MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=your_database_name

# Vercel Deployment (these are automatically set by Vercel)
# VERCEL=1
# VERCEL_ENV=production

# Notes:
# - For Vercel deployment, set these environment variables in your Vercel project settings
# - Database should be accessible from Vercel (consider using PlanetScale, AWS RDS, or similar)
# - File uploads on Vercel are stored in /tmp (ephemeral) - consider using Vercel Blob Storage for persistence
# - Never commit your actual .env file to version control
